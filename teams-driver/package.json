{
  "name": "teams-driver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drives the Microsoft Teams web client, harvests a chat into an Obsidian vault folder.",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "teams-driver": "src/cli.ts"
  },
  "scripts": {
    "teams-driver": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install msedge || playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
